# Public canonical URL; use the final production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://pmalonzo-portfolio.vercel.app

# FormSubmit delivery. Confirm its one-time activation email in this inbox.
CONTACT_TO_EMAIL=malonzo.princebarachiel31@gmail.com
