# Public canonical URL; use the final production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://pmalonzo-portfolio.vercel.app

# EmailJS delivery runs on the server. Set the same values in Vercel's environment settings.
CONTACT_FORM_ENABLED=true
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional unless private-key authorization is enabled in EmailJS. Never expose this key publicly.
EMAILJS_PRIVATE_KEY=

# Optional: a GitHub token enables the official GraphQL API for public activity.
# Without a token the site reads the public GitHub contribution calendar.
GITHUB_TOKEN=
